# Copia este archivo a `.env` (local) y configura los mismos valores en
# Vercel > Project > Settings > Environment Variables.
#
# IMPORTANTE: la URL DEBE incluir el esquema https://
#   ✔  https://repair-service-api.vercel.app
#   ✘  repair-service-api.vercel.app   <- se resolvería como URL relativa y las
#                                          peticiones caerían en el frontend
#                                          (https://pimobile.vercel.app/repair-...)
EXPO_PUBLIC_API_URL=https://repair-service-api.vercel.app

# Opcional: endpoint del backend que recibe la foto de la etiqueta + OCR
# (Gemini). Si no está, el botón "mejorar con IA" no se muestra.
# EXPO_PUBLIC_LABEL_AI_URL=https://repair-service-api.vercel.app/labels/extract
